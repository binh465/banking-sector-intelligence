# News HTML/XML: large, a re-crawl returns different results, not ours to publish.
# Use raw/news/* (not raw/news/) so the negation below can take effect.
raw/news/*
!raw/news/.gitkeep

# Public release only: third-party price and calendar snapshots are not published (see README,
# Data sources and terms). The private repository commits them. .gitkeep stays tracked.
raw/prices/*.parquet
raw/calendar/*.parquet

# Local connection settings (copy config/db.example.yaml to config/db.yaml)
config/db.yaml

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS / editor (.vs/ is created by SSMS / Visual Studio: per-user state)
.vs/
*.slnx
Thumbs.db
desktop.ini
.vscode/

# Power BI project: imported data cache and per-user settings stay local
powerbi/**/.pbi/cache.abf
powerbi/**/.pbi/localSettings.json
