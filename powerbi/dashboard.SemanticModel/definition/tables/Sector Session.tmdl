table 'Sector Session'
	lineageTag: 123a2be1-d468-4679-80b6-adb6e9573516

	measure 'Sector Period Return' = ```
			
			VAR FirstSeq = MIN('Sector Session'[session_seq])
			VAR LastSeq = MAX('Sector Session'[session_seq])
			VAR BaseSeq = MAX(FirstSeq - 1, 1) -- session 1 has no return and index 100, so it is its own base
			
			VAR EndIndex = CALCULATE(MAX('Sector Session'[sector_index]), 'Sector Session'[session_seq] = LastSeq)
			
			VAR BaseIndex = CALCULATE(MAX('Sector Session'[sector_index]), REMOVEFILTERS('Date'), 'Sector Session'[session_seq] = BaseSeq)
			
			RETURN 
			    IF(
			        NOT ISBLANK(LastSeq),
			        DIVIDE(EndIndex, BaseIndex) - 1
			    )
			```
		formatString: 0.0000%;-0.0000%;0.0000%
		lineageTag: 15d00bf5-08fc-4658-9d6e-98ab57ececcd

	/// Returns the appropriate index value for the series currently displayed in the Sector & Ticker Index line chart.
	/// 
	/// - When the selected series is "Sector Index", returns [Sector Index], which represents the equal-weight sector index and is independent of the ticker selection.
	/// - Otherwise, applies the selected ticker from `Index Series[Series]` to `Ticker[ticker]` using `TREATAS` and returns [Ticker Index].
	/// - Respects the current date filter and ticker slicer selections, allowing the sector index and individual ticker indexes to be displayed on a common chart.
	/// - The disconnected `Index Series` table contains display labels only and does not introduce an additional data source.
	/// 
	/// **Maintenance note:** The literal "Sector Index" must remain consistent between the `Index Series` calculated table and this measure. If the label changes in either location, update both to prevent the sector series from disappearing.
	measure 'Index Chart Value' =
			
			VAR SeriesName =
			    SELECTEDVALUE ( 'Index Series'[Series] )
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( SeriesName ), BLANK (),
			        SeriesName = "Sector Index", [Sector Index],
			        CALCULATE (
			            [Ticker Index],
			            KEEPFILTERS( TREATAS(  { SeriesName }, Ticker[ticker] ) )
			        )
			    )
		lineageTag: 95770147-b971-4556-86d4-ab464fb8303f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sector Index' =
			
			VAR LastSeq = MAX('Sector Session'[session_seq])
			RETURN
			    CALCULATE(MAX('Sector Session'[sector_index]), 'Sector Session'[session_seq] = LastSeq)
		lineageTag: aeab2b1b-a25e-487b-a3a2-ad59fd6961e7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

