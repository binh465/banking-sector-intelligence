table 'Ticker Session'
	lineageTag: f51337e6-966d-4722-9fc5-8d23b800c52d

	measure 'Ticker Period Return' =
			
			VAR FirstSeq = MIN('Ticker Session'[session_seq])
			VAR LastSeq = MAX('Ticker Session'[session_seq])
			VAR BaseSeq = MAX(FirstSeq - 1,1) -- session 1 has no return and index 100, so it is its own base
			
			VAR EndIndex = CALCULATE(MAX('Ticker Session'[ticker_index]),'Ticker Session'[session_seq] = LastSeq)
			VAR BaseIndex = CALCULATE(MAX('Ticker Session'[ticker_index]), REMOVEFILTERS('Date'), 'Ticker Session'[session_seq] = BaseSeq)
			
			RETURN
			    IF ( HASONEVALUE ( Ticker[ticker] ) && NOT ISBLANK ( LastSeq ),
			         DIVIDE ( EndIndex, BaseIndex ) - 1 )
		formatString: 0.0000%;-0.0000%;0.0000%
		lineageTag: 17aedf62-3fc8-43a1-881f-995a83f27a01

	/// Ticker period return minus sector period return over the selection, each compounded from its own index. Not the sum or compounded product of the per-session excess_ret column in SQL. Blank when either side is blank.
	measure 'Excess Period Return' =
			
			VAR T = [Ticker Period Return]
			VAR S = [Sector Period Return]
			RETURN
			    IF ( NOT ISBLANK ( T ) && NOT ISBLANK ( S ), T - S )
		formatString: 0.0000%;-0.0000%;0.0000%
		lineageTag: 28cc2eee-484b-4b75-aff4-2faa19652cbe

	measure 'Return Rank' =
			
			IF (
			    HASONEVALUE ( Ticker[ticker] ) && NOT ISBLANK ( [Ticker Period Return] ),
			    RANKX ( ALL ( Ticker[ticker] ), [Ticker Period Return], , DESC, DENSE )
			)
		formatString: 0
		lineageTag: 8e663328-c915-4067-abf5-ecb4effb2266

	measure 'Latest z' =
			
			VAR LastSeq = MAX('Ticker Session'[session_seq])
			RETURN
			    IF(
			        HASONEVALUE(Ticker[ticker]),
			        CALCULATE(MAX('Ticker Session'[z]), 'Ticker Session'[session_seq] = LastSeq)
			    )
		formatString: 0.00
		lineageTag: dca44457-b613-4265-adcd-81c6da06f0a4

	measure 'Latest corr_60' = ```
			
			VAR LastSeq = MAX('Ticker Session'[session_seq])
			RETURN 
			    IF(
			        HASONEVALUE(Ticker[ticker]),
			        CALCULATE(MAX('Ticker Session'[corr_60]), 'Ticker Session'[session_seq] = LastSeq)
			    )
			```
		formatString: 0.000
		lineageTag: 45ca9522-593f-4e6b-adb9-c61c9df27b62

	measure 'Latest RS' = ```
			
			VAR LastSeq = MAX('Ticker Session'[session_seq])
			RETURN 
			    IF(
			        HASONEVALUE(Ticker[ticker]),
			        CALCULATE(MAX('Ticker Session'[rs]), 'Ticker Session'[session_seq] = LastSeq)
			    )
			```
		formatString: 0.00
		lineageTag: 8b5b3bba-71ff-4674-8dbe-d72450b6f64c

	/// Return over the same dates shifted back one month; equals the full previous month only when the selection ends on a month end.
	measure 'Ticker Return PM' =
			
			CALCULATE ( [Ticker Period Return], DATEADD ( 'Date'[full_date], -1, MONTH ) )
		formatString: 0.0000%;-0.0000%;0.0000%
		lineageTag: 6e33953c-448a-4b57-94e5-4c2697a655ec

	measure 'Alert Sessions' =
			
			SUM('Ticker Session'[is_alert])
		formatString: 0
		lineageTag: 9d86fde0-0349-4272-b586-46f13c3747e0

	measure 'Ticker Index' = ```
			
			VAR LastSeq = MAX('Ticker Session'[session_seq])
			RETURN 
			    IF(
			        HASONEVALUE(Ticker[ticker]),
			        CALCULATE(MAX('Ticker Session'[ticker_index]), 'Ticker Session'[session_seq] = LastSeq)
			    )
			```
		lineageTag: 57bea054-1e22-4307-82df-41b1087c2edf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

